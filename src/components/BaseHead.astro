---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/Overload Burn.otf" as="font" type="font/otf" crossorigin />
<link rel="preload" href="/fonts/Superglue.otf" as="font" type="font/otf" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<style is:inline>
  body { opacity: 0; }

  @keyframes slide-out-left {
  0%   { transform: translateX(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
  60%  { transform: translateX(-30px) scale(1); opacity: 0.6; filter: brightness(1.1) blur(0px); }
  100% { transform: translateX(-60px) scale(1); opacity: 0; filter: brightness(1.15) blur(3px); }
}
  @keyframes slide-out-right {
    0%   { transform: translateX(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
    60%  { transform: translateX(30px) scale(1); opacity: 0.6; filter: brightness(1.4) blur(0px); }
    100% { transform: translateX(60px) scale(1); opacity: 0; filter: brightness(2) blur(6px); }
  }
  @keyframes slide-in-left {
    0%   { transform: translateX(-60px) scale(1); opacity: 0; filter: brightness(2) blur(0px); }
    40%  { transform: translateX(-30px) scale(1); opacity: 0.6; filter: brightness(1.4) blur(0px); }
    100% { transform: translateX(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
  }
  @keyframes slide-in-right {
    0%   { transform: translateX(60px) scale(1); opacity: 0; filter: brightness(2) blur(0px); }
    40%  { transform: translateX(30px) scale(1); opacity: 0.6; filter: brightness(1.4) blur(0px); }
    100% { transform: translateX(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
  }
  @keyframes slide-out-down {
    0%   { transform: translateY(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
    60%  { transform: translateY(30px) scale(1); opacity: 0.6; filter: brightness(1.1) blur(0px); }
    100% { transform: translateY(60px) scale(1); opacity: 0; filter: brightness(1.15) blur(3px); }
  }
  @keyframes slide-in-up {
    0%   { transform: translateY(60px) scale(1); opacity: 0; filter: brightness(2) blur(0px); }
    40%  { transform: translateY(30px) scale(1); opacity: 0.6; filter: brightness(1.4) blur(0px); }
    100% { transform: translateY(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
  }
  @keyframes slide-out-up {
    0%   { transform: translateY(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
    60%  { transform: translateY(-30px) scale(1); opacity: 0.6; filter: brightness(1.1) blur(0px); }
    100% { transform: translateY(-60px) scale(1); opacity: 0; filter: brightness(1.15) blur(3px); }
  }
  @keyframes slide-in-down {
    0%   { transform: translateY(-60px) scale(1); opacity: 0; filter: brightness(2) blur(0px); }
    40%  { transform: translateY(-30px) scale(1); opacity: 0.6; filter: brightness(1.4) blur(0px); }
    100% { transform: translateY(0) scale(1); opacity: 1; filter: brightness(1) blur(0px); }
  }
</style>

<script>
  const pageOrder: Record<string, number> = {
    '/': 0,
    '/portfolio': 1,
    '/tarot': 2,
    '/about': 3,
    '/contact': 4,
  };

  const specialPages = new Set([
    '/portfolio/illustrative',
    '/portfolio/non-illustrative',
    '/portfolio/upcoming',
    '/tarot',
  ]);

  const normalizePath = (href: string) => {
    const url = new URL(href, location.origin);
    const pathname = url.pathname.replace(/\/$/, '');
    return pathname === '' ? '/' : pathname;
  };

  document.addEventListener('DOMContentLoaded', () => {
    const direction = sessionStorage.getItem('slideDirection') ?? 'forward';
    const transitionDuration = Number(sessionStorage.getItem('transitionDuration')) || 250;
    const verticalTransition = sessionStorage.getItem('verticalTransition') === 'true';
    sessionStorage.removeItem('slideDirection');
    sessionStorage.removeItem('transitionDuration');
    sessionStorage.removeItem('verticalTransition');
    const currentPath = normalizePath(location.pathname);
    const entranceDelay = ['/','/portfolio'].includes(currentPath) ? 500 : 0;

    const entranceAnimation = currentPath === '/tarot'
      ? 'slide-in-up'
      : verticalTransition
        ? 'slide-in-down'
      : direction === 'forward'
        ? 'slide-in-right'
        : 'slide-in-left';
    const anim = `${entranceAnimation} ${transitionDuration}ms ease-out ${entranceDelay}ms forwards`;

    document.body.style.animation = anim;

    document.body.addEventListener('animationend', () => {
      document.body.style.animation = '';
      document.body.style.transform = '';
      document.body.style.opacity = '1';
    }, { once: true });

    setTimeout(() => {
      document.body.style.animation = '';
      document.body.style.transform = '';
      document.body.style.opacity = '1';
    }, transitionDuration + 200 + entranceDelay);

    document.addEventListener('click', async (e) => {
      const link = (e.target as HTMLElement).closest('a[href]');
      if (!link) return;
      const href = link.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto')) return;
      e.preventDefault();
      e.stopImmediatePropagation();

      const current = normalizePath(location.pathname);
      const target = normalizePath(href);

      document.documentElement.style.backgroundColor = '#00e1ff';
      if (target === '/tarot') {
        window.setTimeout(() => {
          document.documentElement.style.backgroundColor = '#c9a34b';
        }, 150);
      }

      const enteringSpecial = specialPages.has(target) && !specialPages.has(current);
      const leavingSpecial = specialPages.has(current) && !specialPages.has(target);

      let goingForward;
      if (enteringSpecial) {
  goingForward = true; // was false
} else if (leavingSpecial) {
  goingForward = false; // was true
} else {
  const currentIndex = pageOrder[current] ?? 0;
  const targetIndex = pageOrder[target] ?? 0;
  goingForward = targetIndex > currentIndex;
}

      sessionStorage.setItem('slideDirection', goingForward ? 'forward' : 'backward');
      const transitionDuration = 250;
      sessionStorage.setItem('transitionDuration', String(transitionDuration));

      const tarotTransition = current === '/tarot' || target === '/tarot';
      sessionStorage.setItem('verticalTransition', String(tarotTransition));
      const exitAnimation = current === '/tarot'
        ? 'slide-out-down 250ms ease-in both'
        : target === '/tarot'
          ? `slide-out-up ${transitionDuration}ms ease-in both`
        : goingForward
          ? `slide-out-left ${transitionDuration}ms ease-in both`
          : `slide-out-right ${transitionDuration}ms ease-in both`;

      document.body.style.animation = exitAnimation;

await new Promise(r => setTimeout(r, transitionDuration)); // matches the actual animation duration
window.location.href = href;
    }, true);
  });
</script>